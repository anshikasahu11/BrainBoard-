NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/brainboard?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# AI assistant. "mock" is test mode: free, needs no key.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# --- Production only (see the deployment guide) ---
# NODE_ENV=production
# CLIENT_URL=https://your-site.example   (several addresses can be separated by commas)
# TRUST_PROXY=1                          (how many proxies sit in front of the server; measure it with scripts/client-ip-check.mjs)
# DIAGNOSTICS_KEY=                       (temporary, only while measuring TRUST_PROXY; at least 16 characters)
